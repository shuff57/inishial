{
  "name": "inishial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iniSHial — No backpack required. A living syllabus parents initial section by section.",
  "license": "MIT",
  "scripts": {
    "local": "node scripts/dev.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "wrangler pages dev public --d1 DB=inishial",
    "db:local": "node scripts/migrate.mjs --local",
    "db:remote": "node scripts/migrate.mjs --remote",
    "db:upgrade": "node scripts/migrate.mjs --remote --from 6"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
